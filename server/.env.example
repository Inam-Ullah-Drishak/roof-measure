# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Frontend URL: used for CORS and for links in emails / Stripe redirects
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a proxy or load balancer (Render, Railway, Heroku, Nginx)
TRUST_PROXY=

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/roof-measure

# ---------- Auth ----------
# Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- First admin (used by: npm run create-admin) ----------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# ---------- Stripe ----------
# Dashboard > Developers > API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks (or `stripe listen` locally), starts with whsec_
STRIPE_WEBHOOK_SECRET=

# ---------- Email ----------
# Leave SMTP_HOST empty in development: emails are printed to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Roof Measure <no-reply@example.com>"
APP_NAME="Roof Measure"
# Who gets "new paid order" and contact form emails (comma separated).
# Empty = all active admins
ADMIN_NOTIFY_EMAIL=

# ---------- File storage (report files) ----------
# Pick ONE: Cloudinary, or S3-compatible storage.
# Leave both empty in development: files are saved to server/uploads.
# In production you must set one, otherwise files can be lost on redeploy.

# Cloudinary: Dashboard > "API environment variable", looks like
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder in your Cloudinary Media Library (default: roof-measure)
CLOUDINARY_FOLDER=roof-measure
# Max upload size per file in MB (default: 10 with Cloudinary free plan, 25 otherwise)
MAX_UPLOAD_MB=

# S3-compatible (only if not using Cloudinary)
S3_BUCKET=
# AWS: your bucket region (e.g. us-east-1). Cloudflare R2: auto
S3_REGION=
# Only for non-AWS providers, e.g.
#   Cloudflare R2:        https://<account-id>.r2.cloudflarestorage.com
#   DigitalOcean Spaces:  https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for some self-hosted providers (e.g. MinIO)
S3_FORCE_PATH_STYLE=false
